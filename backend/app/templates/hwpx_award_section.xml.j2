<?xml version='1.0' encoding='UTF-8'?>
{% macro cell(text="", label=None, w=8504, h=2400, ca=0, ra=0, colSpan=1, rowSpan=1, header=False, justify=False) -%}
<hp:tc name="" header="0" hasMargin="0" protect="0" editable="0" dirty="0" borderFillIDRef="{{ 4 if header else 3 }}">
