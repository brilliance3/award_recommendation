          {{ cell(text=investigator_rank, w=12756, h=2400, ca=1, ra=1) }}
          {{ cell(label="(19) 성　명", w=8504, h=2400, ca=2, ra=1, header=True) }}
          {{ cell(text=investigator_name ~ " (인)", w=12756, h=2400, ca=3, ra=1) }}
        </hp:tr>
      </hp:tbl>
    </hp:run>
