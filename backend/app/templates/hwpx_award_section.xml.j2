  <hp:p id="2000000010" paraPrIDRef="20" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0">
    <hp:run charPrIDRef="7"><hp:t>공 　 적 　 조 　 서</hp:t></hp:run>
  </hp:p>
  <hp:p id="2000000011" paraPrIDRef="0" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0">
    <hp:run charPrIDRef="0"><hp:t/></hp:run>
  </hp:p>

  {# === 인적사항 표 (4열, 라벨/값/라벨/값) === #}
  {# 본문폭 42520 HWPUNIT, 라벨 8504 (1) + 값 12756 (1.5) + 라벨 8504 (1) + 값 12756 (1.5) = 42520 #}
  <hp:p id="2000000020" paraPrIDRef="0" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0">
    <hp:run charPrIDRef="0">
      <hp:tbl id="2000000100" zOrder="0" numberingType="TABLE" textWrap="TOP_AND_BOTTOM" textFlow="BOTH_SIDES" lock="0" dropcapstyle="None" pageBreak="CELL" repeatHeader="0" rowCnt="9" colCnt="4" cellSpacing="0" borderFillIDRef="3" noAdjust="0">
        <hp:sz width="42520" widthRelTo="ABSOLUTE" height="21600" heightRelTo="ABSOLUTE" protect="0"/>
        <hp:pos treatAsChar="1" affectLSpacing="0" flowWithText="1" allowOverlap="0" holdAnchorAndSO="0" vertRelTo="PARA" horzRelTo="COLUMN" vertAlign="TOP" horzAlign="LEFT" vertOffset="0" horzOffset="0"/>
        <hp:outMargin left="0" right="0" top="0" bottom="0"/>
        <hp:inMargin left="141" right="141" top="141" bottom="141"/>

        {# 1행: (1) 성명 / 값 / (한자) / 한자값 #}
        <hp:tr>
          {{ cell(label="(1) 성　명", w=8504, h=2400, ca=0, ra=0, header=True) }}
          {{ cell(text=recipient_name, w=12756, h=2400, ca=1, ra=0) }}
          {{ cell(label="(한 자)", w=8504, h=2400, ca=2, ra=0, header=True) }}
          {{ cell(text=chinese_name, w=12756, h=2400, ca=3, ra=0) }}
        </hp:tr>

        {# 2행: (2) 생년월일 / 값 (3 colSpan) #}
        <hp:tr>
          {{ cell(label="(2) 생년월일", w=8504, h=2400, ca=0, ra=1, header=True) }}
          {{ cell(text=birth_date, w=34016, h=2400, ca=1, ra=1, colSpan=3) }}
        </hp:tr>

        {# 3행: (3) 군번 / 값 / (4) 국적 / 값 #}
        <hp:tr>
          {{ cell(label="(3) 군번", w=8504, h=2400, ca=0, ra=2, header=True) }}
          {{ cell(text=military_id, w=12756, h=2400, ca=1, ra=2) }}
          {{ cell(label="(4) 국적", w=8504, h=2400, ca=2, ra=2, header=True) }}
          {{ cell(text=nationality, w=12756, h=2400, ca=3, ra=2) }}
        </hp:tr>

        {# 4행: (5) 주소 / 값 (3 colSpan) #}
        <hp:tr>
          {{ cell(label="(5) 주　소", w=8504, h=2400, ca=0, ra=3, header=True) }}
          {{ cell(text=address, w=34016, h=2400, ca=1, ra=3, colSpan=3) }}
        </hp:tr>

        {# 5행: (6) 직업 / 값 / (7) 소속 / 값 #}
        <hp:tr>
          {{ cell(label="(6) 직　업", w=8504, h=2400, ca=0, ra=4, header=True) }}
          {{ cell(text=occupation, w=12756, h=2400, ca=1, ra=4) }}
          {{ cell(label="(7) 소　속", w=8504, h=2400, ca=2, ra=4, header=True) }}
          {{ cell(text=organization_name, w=12756, h=2400, ca=3, ra=4) }}
        </hp:tr>

        {# 6행: (8) 직급 / 값 / (9) 직위 / 값 #}
        <hp:tr>
          {{ cell(label="(8) 직　급", w=8504, h=2400, ca=0, ra=5, header=True) }}
          {{ cell(text=rank_field, w=12756, h=2400, ca=1, ra=5) }}
          {{ cell(label="(9) 직　위", w=8504, h=2400, ca=2, ra=5, header=True) }}
          {{ cell(text=recipient_position_title, w=12756, h=2400, ca=3, ra=5) }}
        </hp:tr>

        {# 7행: (10) 대외직명 / 값 (3 colSpan) #}
        <hp:tr>
          {{ cell(label="(10) 대외직명", w=8504, h=2400, ca=0, ra=6, header=True) }}
          {{ cell(text=external_title, w=34016, h=2400, ca=1, ra=6, colSpan=3) }}
        </hp:tr>

        {# 8행: (11) 공적기간 / 값 / (12) 공적분야 / 값 #}
        <hp:tr>
          {{ cell(label="(11) 공적기간", w=8504, h=2400, ca=0, ra=7, header=True) }}
          {{ cell(text=merit_period, w=12756, h=2400, ca=1, ra=7) }}
          {{ cell(label="(12) 공적분야", w=8504, h=2400, ca=2, ra=7, header=True) }}
          {{ cell(text=merit_category, w=12756, h=2400, ca=3, ra=7) }}
        </hp:tr>

        {# 9행: (14) 추천훈격 / 값 / (15) 추천순위 / 값 #}
        <hp:tr>
          {{ cell(label="(14) 추천훈격", w=8504, h=2400, ca=0, ra=8, header=True) }}
          {{ cell(text=award_grade, w=12756, h=2400, ca=1, ra=8) }}
          {{ cell(label="(15) 추천순위", w=8504, h=2400, ca=2, ra=8, header=True) }}
          {{ cell(text=recommendation_rank, w=12756, h=2400, ca=3, ra=8) }}
        </hp:tr>
      </hp:tbl>
    </hp:run>
  </hp:p>

