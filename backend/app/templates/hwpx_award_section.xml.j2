  <hp:p id="2000000400" paraPrIDRef="20" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0">
    <hp:run charPrIDRef="0"><hp:t>위 기록이 틀림없음을 확인합니다.</hp:t></hp:run>
  </hp:p>
  <hp:p id="2000000401" paraPrIDRef="20" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0">
    <hp:run charPrIDRef="0"><hp:t>{{ recommendation_date }}</hp:t></hp:run>
  </hp:p>
  <hp:p id="2000000402" paraPrIDRef="20" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0">
