        <hp:inMargin left="283" right="283" top="283" bottom="283"/>
        <hp:tr>
          {{ cell(text=merit_short_summary, w=42520, h=6000, ca=0, ra=0, justify=True) }}
        </hp:tr>
      </hp:tbl>
    </hp:run>
