# ===== 로컬 개발용 (.env 로 복사) =====

# 로컬 SQLite
DATABASE_URL=sqlite:///./storage/app.db

# PDF 엔진: playwright 권장 (시스템 라이브러리 불필요)
# WeasyPrint를 쓰려면 macOS는 `brew install pango cairo gdk-pixbuf libffi`
PDF_ENGINE=playwright

# CORS 허용 origin
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 저장소 디렉토리 (배포 시 영구 볼륨 경로로 변경)
# STORAGE_DIR=/app/storage

# AI 보조 (선택)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ===== 운영 (Fly.io 시크릿으로 등록) 예시 =====
# DATABASE_URL=postgresql://postgres:비밀번호@db.프로젝트.supabase.co:5432/postgres
# ALLOWED_ORIGINS=https://award-recommendation.vercel.app
# STORAGE_DIR=/data
